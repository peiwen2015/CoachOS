<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F1E8"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <Button
            android:id="@+id/openGarminButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1.4"
            android:background="@drawable/button_secondary"
            android:text="開 Garmin"
            android:textAllCaps="false"
            android:textColor="#13201A"
            android:textSize="14sp" />

        <Button
            android:id="@+id/clearButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/button_secondary"
            android:text="清除"
            android:textAllCaps="false"
            android:textColor="#13201A"
            android:textSize="14sp" />

        <Button
            android:id="@+id/backButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/button_secondary"
            android:text="返回"
            android:textAllCaps="false"
            android:textColor="#13201A"
            android:textSize="14sp" />
    </LinearLayout>

    <Button
        android:id="@+id/autoCaptureButton"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginBottom="8dp"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:background="@drawable/button_secondary"
        android:text="一鍵擷取並複製"
        android:textAllCaps="false"
        android:textColor="#13201A"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="8dp"
        android:paddingLeft="12dp"
        android:paddingRight="12dp">

        <Button
            android:id="@+id/captureSummaryButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/button_secondary"
            android:text="存數據分頁"
            android:textAllCaps="false"
            android:textColor="#13201A"
            android:textSize="14sp" />

        <Button
            android:id="@+id/captureDetailButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/button_secondary"
            android:text="存第二頁並複製"
            android:textAllCaps="false"
            android:textColor="#13201A"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="8dp"
        android:paddingLeft="12dp"
        android:paddingRight="12dp">

        <Button
            android:id="@+id/previewButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/button_secondary"
            android:text="預覽"
            android:textAllCaps="false"
            android:textColor="#13201A"
            android:textSize="14sp" />

        <Button
            android:id="@+id/shareButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/button_secondary"
            android:text="分享"
            android:textAllCaps="false"
            android:textColor="#13201A"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:text="開啟 Garmin Connect，登入後點進活動。按「一鍵擷取並複製」自動取得數據分頁與間歇訓練。"
        android:textColor="#425047"
        android:textSize="13sp" />

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
