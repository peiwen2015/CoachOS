{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chart-envelope.schema.json",
  "title": "CoachOS Chart Envelope",
  "type": "object",
  "required": [
    "chart_id",
    "schema_version",
    "generated_at",
    "athlete_id",
    "status",
    "title",
    "decision_question",
    "period",
    "summary",
    "axes",
    "series",
    "reference_bands",
    "annotations",
    "verdict",
    "data_quality",
    "drill_down",
    "empty_state"
  ],
  "properties": {
    "chart_id": { "type": "string", "minLength": 1 },
    "schema_version": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "athlete_id": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "partial",
        "estimated",
        "not_applicable",
        "insufficient_data",
        "invalid",
        "error"
      ]
    },
    "title": { "type": "string", "minLength": 1 },
    "decision_question": { "type": "string", "minLength": 1 },
    "period": {
      "type": "object",
      "required": ["start_date", "end_date", "timezone"],
      "properties": {
        "start_date": { "type": "string", "format": "date" },
        "end_date": { "type": "string", "format": "date" },
        "timezone": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "summary": { "type": "object" },
    "axes": { "type": "object" },
    "series": {
      "type": "array",
      "items": { "$ref": "#/$defs/series" }
    },
    "reference_bands": {
      "type": "array",
      "items": { "$ref": "#/$defs/reference_band" }
    },
    "annotations": {
      "type": "array",
      "items": { "$ref": "#/$defs/annotation" }
    },
    "verdict": { "$ref": "#/$defs/verdict" },
    "data_quality": { "$ref": "#/$defs/data_quality" },
    "drill_down": { "$ref": "#/$defs/drill_down" },
    "empty_state": { "$ref": "#/$defs/empty_state" }
  },
  "additionalProperties": true,
  "$defs": {
    "series": {
      "type": "object",
      "required": [
        "series_id",
        "label",
        "type",
        "unit",
        "axis",
        "display_precision",
        "hidden_by_default",
        "source_method",
        "data_quality_status",
        "points"
      ],
      "properties": {
        "series_id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": ["line", "bar", "area", "scatter", "band", "threshold"]
        },
        "unit": { "type": "string", "minLength": 1 },
        "axis": { "type": "string", "minLength": 1 },
        "display_precision": { "type": "integer", "minimum": 0 },
        "hidden_by_default": { "type": "boolean" },
        "source_method": { "type": "string", "minLength": 1 },
        "data_quality_status": { "type": "string", "minLength": 1 },
        "points": {
          "type": "array",
          "items": { "$ref": "#/$defs/point" }
        }
      },
      "additionalProperties": true
    },
    "point": {
      "type": "object",
      "required": ["x", "y", "status", "source"],
      "properties": {
        "x": {},
        "y": {},
        "status": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "reference_band": {
      "type": "object",
      "required": [
        "band_id",
        "label",
        "axis",
        "start_x",
        "end_x",
        "lower",
        "upper",
        "unit",
        "status",
        "method"
      ],
      "properties": {
        "band_id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "axis": { "type": "string", "minLength": 1 },
        "start_x": {},
        "end_x": {},
        "lower": {},
        "upper": {},
        "unit": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "annotation": {
      "type": "object",
      "required": ["annotation_id", "type", "x", "label", "detail", "rule_id", "severity"],
      "properties": {
        "annotation_id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "x": {},
        "label": { "type": "string", "minLength": 1 },
        "detail": { "type": "string", "minLength": 1 },
        "rule_id": { "type": "string", "minLength": 1 },
        "severity": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "verdict": {
      "type": "object",
      "required": ["status", "code", "headline", "message", "confidence", "rule_id", "evidence", "limitations"],
      "properties": {
        "status": { "type": "string", "minLength": 1 },
        "code": { "type": "string", "minLength": 1 },
        "headline": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "confidence": { "type": "string", "minLength": 1 },
        "rule_id": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" }
        },
        "limitations": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "object",
      "required": ["metric", "value", "unit"],
      "properties": {
        "metric": { "type": "string", "minLength": 1 },
        "value": {},
        "unit": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "data_quality": {
      "type": "object",
      "required": [
        "overall_status",
        "completeness_score",
        "confidence",
        "missing_fields",
        "estimated_fields",
        "invalid_fields",
        "coverage",
        "limitations"
      ],
      "properties": {
        "overall_status": { "type": "string", "minLength": 1 },
        "completeness_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "confidence": { "type": "string", "minLength": 1 },
        "missing_fields": {
          "type": "array",
          "items": { "type": "string" }
        },
        "estimated_fields": {
          "type": "array",
          "items": { "type": "string" }
        },
        "invalid_fields": {
          "type": "array",
          "items": { "type": "string" }
        },
        "coverage": { "type": "object" },
        "limitations": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "drill_down": {
      "type": "object",
      "required": ["enabled", "target_type", "target_id", "fields", "notes"],
      "properties": {
        "enabled": { "type": "boolean" },
        "target_type": { "type": "string", "minLength": 1 },
        "target_id": {},
        "fields": {
          "type": "array",
          "items": { "type": "string" }
        },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "empty_state": {
      "type": "object",
      "required": ["title", "message", "action_label", "action_target"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "action_label": { "type": "string", "minLength": 1 },
        "action_target": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    }
  }
}
