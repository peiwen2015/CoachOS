{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workout-completion.schema.json",
  "title": "Workout Completion Chart",
  "allOf": [
    { "$ref": "./chart-envelope.schema.json" },
    {
      "type": "object",
      "properties": {
        "chart_id": { "const": "workout_completion" },
        "analysis_mode": {
          "type": "string",
          "enum": ["goal_vs_actual", "actual_only"]
        },
        "planned_data_status": {
          "type": "string",
          "enum": ["authoritative", "unavailable", "partial"]
        },
        "workout_source": {
          "type": ["string", "null"]
        },
        "alignment_method": { "type": "string" },
        "alignment_confidence": {
          "type": "string",
          "enum": ["high", "medium", "low"]
        }
      },
      "required": [
        "analysis_mode",
        "planned_data_status",
        "workout_source",
        "alignment_method",
        "alignment_confidence"
      ]
    }
  ]
}
